<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="storyDetails"
            type="com.example.deep.model.Stories" />

        <variable
            name="isDelete"
            type="java.lang.Boolean" />

        <import type="android.view.View" />

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginBottom="10dp"
            android:elevation="5dp"
            android:maxHeight="150dp"
            app:cardCornerRadius="10dp"
            android:backgroundTint="@color/action_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_semibold"
                    android:text="@{storyDetails.comments}"
                    android:textAlignment="center"
                    android:textSize="14sp" />

                <RatingBar
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:numStars="5"
                    android:rating="@{storyDetails.rating}"
                    android:stepSize="1"
                    android:theme="@style/RatingBar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="-30dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/lexend_medium"
                        android:text="@{`-`+storyDetails.personName}"
                        android:textAlignment="textEnd"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:fontFamily="@font/lexend_medium"
                        android:text="@{storyDetails.date}"
                        android:textAlignment="textEnd"
                        android:textColor="@color/quantum_googgreen"
                        android:textSize="11sp" />


                </LinearLayout>

                <ImageView
                    android:id="@+id/deleteBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/edt_back"
                    android:elevation="3dp"
                    android:padding="5dp"
                    android:src="@drawable/delete"
                    android:visibility="@{isDelete ? View.GONE : View.VISIBLE}" />


            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>