<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="pledgeDetails"
            type="com.deep.eyedonation.model.Pledges" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:elevation="5dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Pledgee Name and Contact -->
                <TextView
                    android:id="@+id/pledgee_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_semibold"
                    android:text="@{pledgeDetails.personalDetails.fullName}"
                    android:textColor="@color/black"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/contact_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/lexend_medium"
                    android:text="@{`Phone:`+pledgeDetails.personalDetails.mobileNumber + `| Email:`+pledgeDetails.personalDetails.email}"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />

                <!-- Submission Date -->
                <TextView
                    android:id="@+id/pledge_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{`Submitted on:`+pledgeDetails.submittedDate}"
                    android:textColor="@color/grey"
                    android:textSize="12sp" />

                <!-- Donation Details -->
                <TextView
                    android:id="@+id/donation_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/lexend_medium"
                    android:text="@{`Preferred Hospital:`+pledgeDetails.eyeBankDetails.eyeBankName}"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Status Chip -->

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/viewMoreBtn"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="@color/darkgren"
                        android:text="View More"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />


                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>